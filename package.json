{
  "name": "property-icons",
  "version": "0.2.2",
  "description": "Obsidian plugin: badge icons in the file explorer driven by note property rules.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=test/.build --out-extension:.js=.mjs --log-level=warning && node --test test/.build/*.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "file-explorer",
    "frontmatter",
    "icons"
  ],
  "author": "runnerback",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  }
}
